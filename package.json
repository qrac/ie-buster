{
  "name": "ie-buster-monorepo",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w ie-buster",
    "build": "npm run build -w ie-buster",
    "test": "npm run build && node --test packages/ie-buster/tests/*.test.mjs",
    "check": "npm run check -w ie-buster && npm run docs:check",
    "docs": "npm run build && minista ./docs",
    "docs:build": "npm run build && minista build ./docs",
    "docs:preview": "minista preview ./docs",
    "docs:check": "tsc -p docs/tsconfig.json --noEmit",
    "play": "npm run build && vite --config play/vite.config.ts",
    "audit": "npx npm-audit-trace",
    "up": "npx npm-check-updates --deep",
    "up:u": "npx npm-check-updates --deep -u",
    "rev": "npx npm-replace-versions",
    "release": "npm publish -w ie-buster"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "^8.19.0",
    "minista": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
