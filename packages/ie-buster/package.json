{
  "name": "ie-buster",
  "description": "Save web creators with Chrome link popup for IE.",
  "type": "module",
  "version": "2.0.2",
  "cdn": "dist/ie-buster.js",
  "cdn:min": "dist/ie-buster.min.js",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "homepage": "https://ie-buster.qranoko.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrac/ie-buster"
  },
  "bugs": {
    "url": "https://github.com/qrac/ie-buster/issues"
  },
  "keywords": [
    "javascript",
    "ie",
    "ie11",
    "japanese"
  ],
  "author": {
    "name": "Qrac",
    "url": "https://qrac.jp"
  },
  "illustration": {
    "name": "Mainoko",
    "url": "https://mainoko.jp"
  },
  "organization": {
    "name": "QRANOKO",
    "url": "https://qranoko.jp"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build --mode minified && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  }
}
