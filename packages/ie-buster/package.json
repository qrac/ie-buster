{
  "name": "ie-buster",
  "description": "Save web creators with Chrome link popup for IE.",
  "type": "module",
  "version": "2.0.2",
  "cdn": "dist/ie-buster.js",
  "cdn:min": "dist/ie-buster.min.js",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "lib",
    "types"
  ],
  "license": "MIT",
  "homepage": "https://ie-buster.qranoko.jp",
  "repository": {
    "type": "git",
    "url": "https://github.com/qrac/ie-buster"
  },
  "bugs": {
    "url": "https://github.com/qrac/ie-buster/issues"
  },
  "keywords": [
    "javascript",
    "ie",
    "ie11",
    "japanese"
  ],
  "author": {
    "name": "Qrac",
    "url": "https://qrac.jp"
  },
  "illustration": {
    "name": "Mainoko",
    "url": "https://mainoko.jp"
  },
  "organization": {
    "name": "QRANOKO",
    "url": "https://qranoko.jp"
  },
  "scripts": {
    "dev": "npm run clean && rolldown -c --watch",
    "build": "npm run clean && rolldown -c && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "clean": "node scripts/clean.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./lib/*": "./lib/*",
    "./types/*": "./types/*"
  }
}
